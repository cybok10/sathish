# Blog API secrets (copy to server/.env and change the password).
# If ADMIN_PASSWORD is left unset, an unguessable password is generated
# and printed once, when the admin account is first created.
ADMIN_EMAIL=admin@sathish.blog
ADMIN_PASSWORD=change-this-to-a-long-unique-password
ADMIN_NAME=Sathish M

# Optional
API_PORT=8787
SITE_URL=https://rissss21.github.io/portofolio
BASE_PATH=/portofolio
# BLOG_DATA_DIR=/var/lib/portfolio-blog
# BLOG_UPLOAD_DIR=/var/lib/portfolio-blog/uploads
