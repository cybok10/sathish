# Blog API — Supabase + Vercel
#
# Copy this file to `server/.env` and fill it in.
# Never commit the filled-in copy: `server/.env` is already gitignored.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Use the Supabase **session pooler** (port 6543, `?pgbouncer=true`).
# The direct connection (port 5432) exhausts the connection limit under
# serverless load.
#
# Project Settings -> Database -> Connection string -> **Session pooler**
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# ---------------------------------------------------------------------------
# Supabase API + storage
# ---------------------------------------------------------------------------
# Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Server-only. Grants full access — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# The private bucket that holds uploaded images.
# Storage -> New bucket -> name it exactly this, and keep it private.
BLOG_UPLOAD_BUCKET=blog-uploads

# ---------------------------------------------------------------------------
# Admin account
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@sathish.blog
ADMIN_PASSWORD=change-this-to-a-long-unique-password
ADMIN_NAME=Sathish M

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# The public origin, with no trailing slash.
SITE_URL=https://your-domain.com
# The path the site is served from. "/" for a root domain.
BASE_PATH=/

# Optional
API_PORT=8787
# The connection pool size for serverless. Keep it small.
DB_POOL_MAX=5

# Only used when Supabase Storage is not configured (local development).
# BLOG_DATA_DIR=/var/lib/portfolio-blog
# BLOG_UPLOAD_DIR=/var/lib/portfolio-blog/uploads
